* {
    background:         {{colors.surface.default.hex}}FF;
    background-alt:     {{colors.surface_container_highest.default.hex}}FF;

    foreground:         {{colors.on_surface.default.hex}}FF;
    selected:           {{colors.source_color.default.hex}}FF;
    active:             {{colors.tertiary.default.hex}}FF;
    urgent:             {{colors.error.default.hex}}FF;

    cursor-color:       {{colors.primary.default.hex}}FF;
    border-color:       {{colors.primary.default.hex}}FF;
    inactive-border:    {{colors.outline.default.hex}}FF;

    black:              {{base16.base00.default.hex}}FF;
    red:                {{base16.base08.default.hex}}FF;
    green:              {{base16.base0b.default.hex}}FF;
    yellow:             {{base16.base0a.default.hex}}FF;
    blue:               {{colors.primary.default.hex}}FF;
    magenta:            {{colors.primary_fixed_dim.default.hex}}FF;
    cyan:               {{base16.base0c.default.hex}}FF;
    white:              {{colors.on_surface_variant.default.hex}}FF;
    highlight:          {{colors.source_color.default.hex}}FF;

    bright-black:       {{base16.base03.default.hex}}FF;
    bright-red:         {{base16.base04.default.hex}}FF;
    bright-blue:        {{colors.primary_fixed.default.hex}}FF;
    bright-magenta:     {{colors.inverse_primary.default.hex}}FF;
}
