#! /bin/sh
set -e

# RetroLinux GRUB template - generates the RetroLinux boot menu.
#
# This file replaces the stock Arch /etc/grub.d/10_linux so the boot menu is
# generated deterministically on every grub-mkconfig run. Do not edit it by
# hand: the retro grub module rewrites it (the chosen default kernel below is
# substituted at install time from @RETRO_KERNEL@).

prefix="/usr"
exec_prefix="/usr"
datarootdir="/usr/share"

. "$pkgdatadir/grub-mkconfig_lib"

export TEXTDOMAIN=grub
export TEXTDOMAINDIR="${datarootdir}/locale"

CLASS="--class retrolinux --class gnu-linux --class gnu --class os"
OS="RetroLinux"

case ${GRUB_DEVICE} in
  /dev/loop/*|/dev/loop[0-9])
    GRUB_DEVICE=`losetup ${GRUB_DEVICE} | sed -e "s/^[^(]*(\([^)]\+\)).*/\1/"`
  ;;
esac

# --- root= device detection (identical to the stock Arch 10_linux) ---
# Handles plain block devices, UUID/PARTUUID and LVM (forced to device).
if ( [ "x${GRUB_DEVICE_UUID}" = "x" ] && [ "x${GRUB_DEVICE_PARTUUID}" = "x" ] ) \
    || ( [ "x${GRUB_DISABLE_LINUX_UUID}" = "xtrue" ] \
	&& [ "x${GRUB_DISABLE_LINUX_PARTUUID}" = "xtrue" ] ) \
    || ( ! test -e "/dev/disk/by-uuid/${GRUB_DEVICE_UUID}" \
	&& ! test -e "/dev/disk/by-partuuid/${GRUB_DEVICE_PARTUUID}" ) \
    || ( test -e "${GRUB_DEVICE}" && uses_abstraction "${GRUB_DEVICE}" lvm ); then
  LINUX_ROOT_DEVICE=${GRUB_DEVICE}
elif [ "x${GRUB_DEVICE_UUID}" = "x" ] \
    || [ "x${GRUB_DISABLE_LINUX_UUID}" = "xtrue" ]; then
  LINUX_ROOT_DEVICE=PARTUUID=${GRUB_DEVICE_PARTUUID}
else
  LINUX_ROOT_DEVICE=UUID=${GRUB_DEVICE_UUID}
fi

# --- btrfs subvolume root= handling ---
case x"$GRUB_FS" in
    xbtrfs)
	rootsubvol="`make_system_path_relative_to_its_root /`"
	rootsubvol="${rootsubvol#/}"
	if [ "x${rootsubvol}" != x ]; then
	    GRUB_CMDLINE_LINUX="rootflags=subvol=${rootsubvol} ${GRUB_CMDLINE_LINUX}"
	fi;;
esac

# --- Selected default kernel ---
# Stable /boot paths keep the entry working across kernel package updates.
kernel="@RETRO_KERNEL@"

linux=""
for cand in "/boot/vmlinuz-${kernel}" "/boot/vmlinuz-linux"; do
  if test -f "$cand"; then
    linux="$cand"
    break
  fi
done
if [ -z "$linux" ]; then
  for i in /boot/vmlinuz-* /vmlinuz-*; do
    if grub_file_is_not_garbage "$i"; then
      linux="$i"
      break
    fi
  done
fi

if [ -z "$linux" ]; then
  exit 0
fi

basename=`basename "$linux"`
dirname=`dirname "$linux"`
rel_dirname=`make_system_path_relative_to_its_root "$dirname"`
version=`echo "$basename" | sed -e "s,vmlinuz-,,g"`
linux_root_device_thisversion="${LINUX_ROOT_DEVICE}"

# Early initrd (microcode) and main initramfs.
initrd_early=
for i in ${GRUB_EARLY_INITRD_LINUX_STOCK} ${GRUB_EARLY_INITRD_LINUX_CUSTOM}; do
    if test -e "${dirname}/${i}"; then
        initrd_early="${initrd_early} ${i}"
    fi
done

initrd_real=
for i in "initramfs-${version}.img" "initrd.img-${version}" "initrd-${version}.img" "initramfs-${version}"; do
    if test -e "${dirname}/${i}"; then
        initrd_real="${i}"
        break
    fi
done

initrd=
if test -n "${initrd_early}" || test -n "${initrd_real}"; then
    initrd="${initrd_early} ${initrd_real}"
fi

# --- Main RetroLinux entry ---
device_id="$(grub_get_device_id "${GRUB_DEVICE}")"

echo "menuentry '${OS}' ${CLASS} \$menuentry_id_option 'gnulinux-simple-${device_id}' {"
save_default_entry | grub_add_tab
if [ "x$GRUB_GFXPAYLOAD_LINUX" = x ]; then
    echo "	load_video"
elif [ "x$GRUB_GFXPAYLOAD_LINUX" != xtext ]; then
    echo "	load_video"
    echo "	set gfxpayload=$GRUB_GFXPAYLOAD_LINUX"
else
    echo "	set gfxpayload=text"
fi
echo "	insmod gzio"
if [ x$dirname = x/ ]; then
    prepare_grub_to_access_device ${GRUB_DEVICE} | grub_add_tab
else
    prepare_grub_to_access_device ${GRUB_DEVICE_BOOT} | grub_add_tab
fi
echo "	linux	${rel_dirname}/${basename} root=${linux_root_device_thisversion} rw ${GRUB_CMDLINE_LINUX} ${GRUB_CMDLINE_LINUX_DEFAULT}"
if test -n "${initrd}"; then
    initrd_path=
    for i in ${initrd}; do
        initrd_path="${initrd_path} ${rel_dirname}/${i}"
    done
    echo "	initrd	$(echo $initrd_path)"
fi
echo "}"

# --- RetroLinux snapshots submenu (snapshot list generated by grub-btrfsd) ---
echo "submenu 'RetroLinux Snapshots' --class retrolinux --class btrfs {"
echo "	if [ -f \"\${prefix}/grub-btrfs.cfg\" ]; then"
echo "		configfile \"\${prefix}/grub-btrfs.cfg\""
echo "	fi"
echo "}"

# --- UEFI firmware settings ---
echo "menuentry 'UEFI Firmware Settings' --class efi --id 'uefi-firmware' {"
echo "	if [ \"\${grub_platform}\" == \"efi\" ]; then"
echo "		fwsetup"
echo "	fi"
echo "}"

# --- Run Memtest86+ ---
echo "menuentry 'Run Memtest86+ (RAM test)' --class memtest86 --class memtest --class gnu --class tool {"
echo "	set gfxpayload=1920x1080,1024x768"
echo "	if [ -f \"/boot/memtest86+/memtest.efi\" ]; then"
echo "		linux /boot/memtest86+/memtest.efi"
echo "	else"
echo "		linux /boot/memtest86+/memtest"
echo "	fi"
echo "}"

# --- Power entries ---
echo "menuentry 'System restart' --class reboot --class restart {"
echo "	echo 'System rebooting...'"
echo "	reboot"
echo "}"

echo "menuentry 'System shutdown' --class shutdown --class poweroff {"
echo "	echo 'System shutting down...'"
echo "	halt"
echo "}"
