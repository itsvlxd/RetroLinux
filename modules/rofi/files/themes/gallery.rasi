@import                          "~/.config/retro/themes/rofi-colors.rasi"
@import                          "~/.config/retro/themes/variables.rasi"

configuration {
    show-icons:                  true;
    hover-select:                true;
    hover-select:                true;
    me-select-entry:             "";
    me-select-entry:             "MousePrimary";
    me-accept-entry:             "!MousePrimary";
    click-to-exit:               true;
}

window {
    font:                        @rofi-font;
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       800px;
    x-offset:                    0px;
    y-offset:                    40%;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      @rofi-border;
    border-radius:               @rofi-radius;
    border-color:                @background-alt;
    background-color:            @background;
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               1px;
    border-color:                @selected;
    background-color:            transparent;
    children:                    [ "inputbar", "listview", "mode-switcher" ];
}

inputbar {
    enabled:                     true;
    spacing:                     15px;
    margin:                      10px;
    padding:                     12px 20px;
    border:                      0px solid;
    border-radius:               @rofi-radius;
    border-color:                @selected;
    text-color:                  @foreground;
    children:                    [ "textbox-icon", "entry" ];
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    cursor-width:                1px;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
}

textbox-icon {
    expand:                      false;
    str:                         " ";
    text-color:                  @highlight;
    background-color:            transparent;
    vertical-align:              0;
}

scrollbar {
    width:                       1px;
    border:                      0;
    handle-width:                2px;
    handle-color:                @highlight; 
    padding:                     0;
    background-color:            @background-alt; 
    border-radius:               @rofi-radius;
}

listview {
    enabled:                     true;
    columns:                     4;
    lines:                       2;
    cycle:                       true;
    dynamic:                     false;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     5px;
    margin:                      0px 5px;
    padding:                     @rofi-padding;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     0px;
    margin:                      0px;
    padding:                     @rofi-padding;
    border:                      0px solid;
    border-radius:               @rofi-radius;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
    children:                    [ "element-icon", "element-text" ];
}

element normal.normal {
    text-color:                  @foreground;
}

element selected.normal {
    text-color:                  @foreground; 
    border-color:                @selected;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        128px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    margin:                      0px 0px 5px 0px;
    vertical-align:              0.0;
    horizontal-align:            0.5;
    markup:                      true;
}

mode-switcher {
    enabled:                     true;
    spacing:                     10px;
    margin:                      10px;
    background-color:            transparent;
}

button {
    padding:                     @rofi-padding;
    border-radius:               @rofi-radius;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      pointer;
}

button selected {
    background-color:            @selected; 
    text-color:                  @foreground;
}
