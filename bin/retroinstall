#!/bin/bash

export RETRO_DIR="/opt/retrolinux"
export RETRO_INSTALL="/opt/retrolinux/bin"
export RETRO_STATE="/tmp/retroinstall_state"

RX_DEBUG=0
if [[ ${1:-} == "--debug" ]]; then
    RX_DEBUG=1
    export RX_DEBUG
    shift
fi

source "$RETRO_INSTALL/lib/display.sh"
source "$RETRO_INSTALL/lib/errors.sh"
source "$RETRO_INSTALL/lib/gum.sh"
source "$RETRO_INSTALL/lib/wifi.sh"
source "$RETRO_INSTALL/lib/qr.sh"
source "$RETRO_INSTALL/lib/locale.sh"
source "$RETRO_INSTALL/lib/timezone.sh"
source "$RETRO_INSTALL/lib/handlers.sh"
source "$RETRO_INSTALL/lib/output.sh"
source "$RETRO_INSTALL/lib/debug.sh"

rx_set_retro_colors
rx_setup_traps

SETUP_SCRIPTS=(
    "network.sh"
    "keyboard.sh"
    "locale.sh"
    "timezone.sh"
    "user.sh"
    "disk.sh"
    "config.sh"
)

if [[ -f $RETRO_STATE ]]; then
    rx_load_state
else
    KEYBOARD="us"
    SYS_LANG="en_US.UTF-8"
    SYS_ENC="UTF-8"
    USER_PASSWORD_HASH=""
    USER_PASSWORD=""
    USER_NAME=""
    USER_HOSTNAME=""
    USER_TIMEZONE=""
    DISK_SELECTED=""
    rx_save_state
fi

rx_show_error_and_qr() {
    local exit_code=$1
    rx_clear_logo
    rx_show_cursor
    gum style --foreground 1 --padding "1 0 1 $PADDING_LEFT" "RetroLinux installation stopped!"
    gum style --foreground 1 --padding "1 0 1 $PADDING_LEFT" "Error during setup (exit code: $exit_code)"
    echo
    rx_generate_error_qr "$exit_code"
    echo
    gum style "Get help at https://github.com/itsvlxd/RetroLinux/issues"
    echo
    gum confirm --affirmative "Retry installation" --negative "Exit" --padding "$GUM_CONFIRM_PADDING" && exec /opt/retrolinux/bin/retroinstall || exit 1
}

rx_run_step() {
    local script="$1"

    rx_clear_logo
    rx_load_state
    /opt/retrolinux/bin/setup/"$script"
    local exit_code=$?
    rx_load_state
    if [[ $exit_code -eq 42 ]]; then
        exec /opt/retrolinux/bin/retroinstall
    elif [[ $exit_code -ne 0 ]]; then
        rx_show_error_and_qr "$exit_code"
    fi
}

for script in "${SETUP_SCRIPTS[@]}"; do
    rx_run_step "$script"
done

rx_install_system() {
    rx_load_state

    rx_clear_logo
    gum style --padding "1 0 1 $PADDING_LEFT" "Lets configure your RetroLinux installation..."

    local disk_name disk_size
    disk_name=$(basename "$DISK_SELECTED" 2>/dev/null || echo "?")
    disk_size=$(lsblk -dno SIZE "$DISK_SELECTED" 2>/dev/null || echo "?")

    local network_info="Ethernet"
    if [[ "${NETWORK_TYPE:-}" == "WiFi" ]]; then
        network_info="WiFi (${WIFI_SSID:-unknown})"
    fi

    echo -e "Field,Value\nDisk,/dev/${disk_name} (${disk_size})\nNetwork,${network_info}\nKeyboard,$(rx_keyboard_display_name "${KEYBOARD:-us}")\nLanguage,$(rx_locale_to_lang_name "${SYS_LANG:-en_US.UTF-8}")\nTimezone,${USER_TIMEZONE:-unknown}\nUsername,${USER_NAME:-unknown}\nHostname,${USER_HOSTNAME:-unknown}" | \
        gum table -s "," -p | sed "s/^/${PADDING_LEFT_SPACES}/"
    echo

    if gum confirm --affirmative "Install now" --negative "Go back" "Ready to Install" $GUM_CONFIRM_STYLE --padding "$GUM_CONFIRM_PADDING"; then
        :
    else
        exec /opt/retrolinux/bin/retroinstall
    fi

    rx_clear_logo
    echo
    gum style --foreground 3 --padding "1 0 1 $PADDING_LEFT" "Installing RetroLinux..."
    echo

    archinstall \
        --config user_configuration.json \
        --creds user_credentials.json \
        --silent \
        --skip-ntp \
        --skip-wkd \
        --skip-wifi-check

    local arch_exit_code=$?

    if [[ $arch_exit_code -ne 0 ]]; then
        rx_clear_logo
        echo
        gum style --foreground 1 --padding "1 0 1 $PADDING_LEFT" "Installation failed (exit code: $arch_exit_code)"
        echo
        rx_generate_error_qr "$arch_exit_code"
        echo
        gum confirm --affirmative "Retry" --negative "Exit" --padding "$GUM_CONFIRM_PADDING" && exec /opt/retrolinux/bin/retroinstall || exit 1
    fi

    rx_clear_logo
    echo
    gum style --foreground 2 --padding "1 0 1 $PADDING_LEFT" "Installation Complete!"
    gum style --padding "1 0 1 $PADDING_LEFT" "Reboot to start using RetroLinux."
    echo
    gum style --foreground 7 "Press Enter to reboot or Ctrl+C to exit."
    read -r

    reboot
}

if [[ $1 != "dry" ]]; then
    rx_install_system
else
    echo "User Configuration:"
    cat user_configuration.json
    echo "User Credentials:"
    cat user_credentials.json
    rm user_configuration.json user_credentials.json
fi
