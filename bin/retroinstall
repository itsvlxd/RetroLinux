#!/bin/bash

export RETRO_DIR="/opt/retrolinux"
export RETRO_INSTALL="/opt/retrolinux/bin"
export RETRO_STATE="/tmp/retroinstall_state"

RX_DEBUG=0
if [[ ${1:-} == "--debug" ]]; then
    RX_DEBUG=1
    export RX_DEBUG
    shift
fi

source "$RETRO_INSTALL/lib/display.sh"
source "$RETRO_INSTALL/lib/errors.sh"
source "$RETRO_INSTALL/lib/gum.sh"
source "$RETRO_INSTALL/lib/wifi.sh"
source "$RETRO_INSTALL/lib/qr.sh"
source "$RETRO_INSTALL/lib/locale.sh"
source "$RETRO_INSTALL/lib/timezone.sh"
source "$RETRO_INSTALL/lib/handlers.sh"
source "$RETRO_INSTALL/lib/output.sh"
source "$RETRO_INSTALL/lib/debug.sh"

rx_set_retro_colors
rx_setup_traps

SETUP_SCRIPTS=(
    "user.sh"
    "root.sh"
    "hostname.sh"
    "keyboard.sh"
    "locale.sh"
    "mirrors.sh"
    "timezone.sh"
    "disk.sh"
    "luks.sh"
    "kernel.sh"
    "boot.sh"
    "bluetooth.sh"
    "fingerprint.sh"
    "print.sh"
    "ssh.sh"
    "aur.sh"
    "editor.sh"
    "filemanager.sh"
    "browser.sh"
    "network.sh"
    "config.sh"
)

if [[ -f $RETRO_STATE ]]; then
    rx_load_state
else
    KEYBOARD="us"
    SYS_LANG="en_US"
    SYS_ENC="UTF-8"
    USER_NAME=""
    USER_PASSWORD=""
    USER_HOSTNAME=""
    ROOT_PASSWORD=""
    USER_SUDO="true"
    MIRROR_REGIONS=""
    CUSTOM_MIRRORS=""
    USER_TIMEZONE=""
    DISK_SELECTED=""
    LUKS_ENABLED=""
    LUKS_PASSWORD=""
    LUKS_ITER_TIME=""
    KERNEL_SELECTION=""
    BLUETOOTH_ENABLED=""
    PRINT_SERVICE_ENABLED=""
    GRUB_THEME_CHOICE=""
    BOOT_VIDEO_GRUB=""
    GRUB_OS_PROBER=""
    SSH_ENABLED=""
    SSH_PORT=""
    SSH_PASSWORD_LOGIN=""
    SSH_KEY_LOGIN=""
    SSH_ROOT_LOGIN=""
    AUR_HELPER=""
    EDITOR_CHOICE=""
    FILEMANAGER_CHOICE=""
    FINGERPRINT_ENABLED=""
    NETWORK_TYPE=""
    WIFI_SSID=""
    RX_SKIP_STEP=""
    RX_GO_BACK_TO=""
    rx_save_state
fi

rx_show_error_and_qr() {
    local exit_code=$1
    rx_clear_logo
    rx_show_cursor
    gum style --foreground 1 --padding "1 0 1 $PADDING_LEFT" "RetroLinux installation stopped!"
    gum style --foreground 1 --padding "1 0 1 $PADDING_LEFT" "Error during setup (exit code: $exit_code)"
    echo
    rx_generate_error_qr "$exit_code"
    echo
    gum style "Get help at https://github.com/itsvlxd/RetroLinux/issues"
    echo
    gum confirm --affirmative "Retry installation" --negative "Exit" --padding "$GUM_CONFIRM_PADDING" && exec /opt/retrolinux/bin/retroinstall || exit 1
}

rx_run_step() {
    local script="$1"
    local step_index=$2

    if [[ -n $RX_SKIP_STEP && $step_index -le $RX_SKIP_STEP ]]; then
        return 0
    fi

    rx_clear_logo
    rx_load_state
    /opt/retrolinux/bin/setup/"$script"
    local exit_code=$?
    rx_load_state
    if [[ $exit_code -eq 42 ]]; then
        RX_SKIP_STEP=6
        rx_save_state
        exec /opt/retrolinux/bin/retroinstall
    elif [[ $exit_code -ne 0 ]]; then
        rx_show_error_and_qr "$exit_code"
    fi
}

for i in "${!SETUP_SCRIPTS[@]}"; do
    rx_run_step "${SETUP_SCRIPTS[$i]}" "$i"
done

rx_install_system() {
    rx_load_state

    rx_clear_logo
    gum style --padding "1 0 1 $PADDING_LEFT" "Lets configure your RetroLinux installation..."

    local disk_name disk_size
    disk_name=$(basename "$DISK_SELECTED" 2>/dev/null || echo "?")
    disk_size=$(lsblk -dno SIZE "$DISK_SELECTED" 2>/dev/null | tr -d ' ' || echo "?")

    local network_info="Ethernet"
    if [[ ${NETWORK_TYPE:-} == "WiFi" ]]; then
        network_info="WiFi (${WIFI_SSID:-unknown})"
    fi

    local luks_info="Disabled"
    local luks_pw_dots=""
    if [[ $LUKS_ENABLED == "true" ]]; then
        luks_info="Enabled (${LUKS_ITER_TIME:-2000}ms iter)"
        if [[ -n $LUKS_PASSWORD ]]; then
            local luks_pw_len=${#LUKS_PASSWORD}
            luks_pw_dots=$(printf '%*s' "$luks_pw_len" | tr ' ' '•')
        fi
    fi

    local root_pw_dots=""
    local root_pw_len=0
    if [[ -n ${ROOT_PASSWORD:-} ]]; then
        root_pw_len=${#ROOT_PASSWORD}
        root_pw_dots=$(printf '%*s' "$root_pw_len" | tr ' ' '•')
    fi

    local user_pw_dots=""
    local user_pw_len=0
    if [[ -n $USER_PASSWORD ]]; then
        user_pw_len=${#USER_PASSWORD}
        user_pw_dots=$(printf '%*s' "$user_pw_len" | tr ' ' '•')
    fi

    local bt_info="Disabled"
    if [[ $BLUETOOTH_ENABLED == "true" ]]; then
        bt_info="Enabled"
    fi

    local print_info="Disabled"
    if [[ $PRINT_SERVICE_ENABLED == "true" ]]; then
        print_info="Enabled"
    fi

    local ssh_info="Disabled"
    if [[ $SSH_ENABLED == "true" ]]; then
        ssh_info="Port ${SSH_PORT:-22}"
        local ssh_flags=""
        [[ $SSH_PASSWORD_LOGIN == "true" ]] && ssh_flags="${ssh_flags} pwd"
        [[ $SSH_KEY_LOGIN == "true" ]] && ssh_flags="${ssh_flags} key"
        [[ $SSH_ROOT_LOGIN == "true" ]] && ssh_flags="${ssh_flags} root"
        ssh_info="${ssh_info}${ssh_flags}"
    fi

    local aur_info="${AUR_HELPER:-yay}"

    local editor_info="${EDITOR_CHOICE:-nano}"

    local filemanager_info="${FILEMANAGER_CHOICE:-thunar}"

    local browser_info="${BROWSER_CHOICE:-zen-browser-bin}"

    local boot_info="GRUB ${GRUB_THEME_CHOICE:-retropunk} ${BOOT_VIDEO_GRUB:-1920x1080}"
    if [[ $GRUB_OS_PROBER == "true" ]]; then
        boot_info="$boot_info + OS Prober"
    fi

    local sudo_info="Yes"
    if [[ $USER_SUDO == "false" ]]; then
        sudo_info="No"
    fi

    local mirror_info="Auto"
    if [[ -n $MIRROR_REGIONS ]]; then
        mirror_info="$MIRROR_REGIONS"
    fi
    if [[ -n $CUSTOM_MIRRORS ]]; then
        mirror_info="$mirror_info + custom"
    fi

    local table_data="Username,${USER_NAME:-unknown}
User Password,${user_pw_dots}
Root Password,${root_pw_dots}
Hostname,${USER_HOSTNAME:-unknown}
Sudo Access,${sudo_info}
Keyboard,$(rx_keyboard_display_name "${KEYBOARD:-us}")
Language,$(rx_locale_to_lang_name "${SYS_LANG:-en_US}")
Mirrors,${mirror_info}
Timezone,${USER_TIMEZONE:-unknown}
Disk,/dev/${disk_name} (${disk_size})
LUKS Encryption,${luks_info} (${luks_pw_dots:-none})
Kernel,${KERNEL_SELECTION:-linux}
Bootloader,${boot_info}
Bluetooth,${bt_info}
Printing,${print_info}
SSH,${ssh_info}
AUR Helper,${aur_info}
Editor,${editor_info}
File Manager,${filemanager_info}
Browser,${browser_info}
Network,${network_info}"

    echo "$table_data" | gum table -s "," -c "Field,Value" -p | sed "s/^/${PADDING_LEFT_SPACES}/"
    echo

    if gum confirm --affirmative "Install now" --negative "Go back" "Ready to Install" $GUM_CONFIRM_STYLE --padding "$GUM_CONFIRM_PADDING"; then
        :
    else
        exec /opt/retrolinux/bin/retroinstall
    fi

    rx_clear_logo
    echo
    gum style --foreground 3 --padding "1 0 1 $PADDING_LEFT" "Installing RetroLinux..."
    echo

    archinstall \
        --config user_configuration.json \
        --creds user_credentials.json \
        --silent \
        --skip-ntp \
        --skip-wkd \
        --skip-wifi-check

    local arch_exit_code=$?

    if [[ $arch_exit_code -ne 0 ]]; then
        rx_clear_logo
        echo
        gum style --foreground 1 --padding "1 0 1 $PADDING_LEFT" "Installation failed (exit code: $arch_exit_code)"
        echo
        rx_generate_error_qr "$arch_exit_code"
        echo
        gum confirm --affirmative "Retry" --negative "Exit" --padding "$GUM_CONFIRM_PADDING" && exec /opt/retrolinux/bin/retroinstall || exit 1
    fi

    rx_clear_logo
    echo
    gum style --foreground 7 "Running post-installation..." --padding "1 0 1 $PADDING_LEFT"
    echo

    bash /opt/retrolinux/bin/post/run.sh

    rx_clear_logo
    echo
    gum style --foreground 2 --padding "1 0 1 $PADDING_LEFT" "Installation Complete!"
    gum style --padding "1 0 1 $PADDING_LEFT" "Reboot to start using RetroLinux."
    echo
    gum style --foreground 7 "Press Enter to reboot or Ctrl+C to exit."
    read -r

    reboot
}

if [[ $1 != "dry" ]]; then
    rx_install_system
else
    echo "User Configuration:"
    cat user_configuration.json
    echo "User Credentials:"
    cat user_credentials.json
    rm user_configuration.json user_credentials.json
fi
